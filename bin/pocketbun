#!/usr/bin/env bun
// PocketBun-only: Bun CLI entrypoint that mirrors the PocketBase binary interface.
// In local development, prefer source to avoid stale dist artifacts between edits.

const cliModule = await import("../src/cli.ts").catch(async () => import("../dist/src/cli.js"));
const main = (cliModule as { main: () => Promise<void> }).main;

try {
  await main();
  // Force process termination after graceful shutdown to avoid requiring a
  // second SIGINT when background handles (watchers/timers) are still open.
  process.exit(0);
} catch (error) {
  console.error(error);
  process.exit(1);
}
