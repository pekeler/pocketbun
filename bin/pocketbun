#!/usr/bin/env bun
// PocketBun-only: Bun CLI entrypoint that mirrors the PocketBase binary interface.

import { main } from "../dist/src/cli.js";

try {
  await main();
  // Force process termination after graceful shutdown to avoid requiring a
  // second SIGINT when background handles (watchers/timers) are still open.
  process.exit(0);
} catch (error) {
  console.error(error);
  process.exit(1);
}
