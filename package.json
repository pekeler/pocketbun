{
  "name": "pocketbun",
  "version": "0.39.4-pocketbun.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pekeler/pocketbun.git"
  },
  "bugs": {
    "url": "https://github.com/pekeler/pocketbun/issues"
  },
  "homepage": "https://github.com/pekeler/pocketbun#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "pocketbun": "bin/pocketbun"
  },
  "scripts": {
    "upstream:sync": "bash scripts/sync_upstream_pocketbase.sh",
    "upstream:sync:benchmarks": "bash scripts/sync_upstream_benchmarks.sh",
    "upstream:audit": "bun run scripts/audit_upstream_mapping.ts",
    "docs:sync-upstream": "bash scripts/docs/sync_upstream_site_docs.sh",
    "docs:patch": "bun run scripts/docs/apply_pocketbun_patches.ts",
    "docs:version": "bun run scripts/docs/sync_docs_version.ts",
    "docs:rebuild": "bun run scripts/docs/rebuild_from_upstream.ts && bun run docs:patch && bun run docs:version",
    "docs:check": "bun run scripts/docs/sync_docs_version.ts --check && bun run scripts/docs/check_generated_docs.ts",
    "docs:rebuild:full": "bun run docs:sync-upstream && bun run docs:rebuild && bun run docs:check",
    "check:versions": "bun run scripts/check_versions.ts && bun run scripts/docs/sync_docs_version.ts --check",
    "test": "bun test --concurrent",
    "test:randomize": "bun test --concurrent --randomize",
    "agent-script": "bun run scripts/agent_script.ts",
    "start": "bun run index.ts",
    "typecheck": "bun x tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "oxlint --type-aware src tests scripts",
    "format": "oxfmt --check src tests scripts",
    "format:fix": "oxfmt --write src tests scripts",
    "build": "bun build index.ts src/cli.ts --outdir dist --target bun --format esm --packages external && bun run build:types",
    "build:types": "bun x tsc -p tsconfig.types.json && bun run scripts/build_declarations.ts",
    "build:analyze": "bun build index.ts src/cli.ts --outdir=.tmp/build-analysis --target=bun --format=esm --packages external --metafile=.tmp/build-analysis/meta.json --metafile-md=.tmp/build-analysis/meta.md",
    "profile:cpu": "bash scripts/profile_cpu_md.sh",
    "profile:heap": "bash scripts/profile_heap_md.sh",
    "profile:heap:scenario": "bash scripts/profile_heap_scenario.sh",
    "profile:inspector:list": "bun run scripts/profile_inspector_records_list.ts",
    "prepack": "bun run build",
    "bench:upstream": "bun run scripts/bench_run_upstream.ts",
    "bench:upstream:pocketbun": "bun run scripts/bench_run_upstream_pocketbun.ts",
    "bench:upstream:factor-summary": "bun scripts/bench_upstream_factor_summary.js",
    "typecheck:package": "bun run build && bun run scripts/check_package_types.ts",
    "release:check": "bun run format:fix && bun run check:versions && bun test --concurrent && bun run typecheck && bun run typecheck:package && bun run lint",
    "release:dry": "bash scripts/release.sh dry pocketbun",
    "release": "bash scripts/release.sh publish pocketbun",
    "release:create:dry": "bash scripts/release.sh dry create-pocketbun",
    "release:create": "bash scripts/release.sh publish create-pocketbun",
    "e2e": "bun run scripts/e2e_run.ts",
    "e2e:install": "playwright install --with-deps"
  },
  "files": [
    "bin/pocketbun",
    "dist/",
    "README.md",
    "LICENSE.md",
    "pocketbase_tag.txt",
    "src/plugins/jsvm/internal/types/generated/types.d.ts",
    "src/ui/admin_branding.js",
    "vendor/pocketbase-admin-ui/dist/",
    "vendor/pocketbase-admin-ui/LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.43.0",
    "oxlint-tsgolint": "^0.11.5",
    "pocketbase": "^0.26.8"
  },
  "peerDependencies": {
    "go-text-template": "*",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "go-text-template": {
      "optional": true
    }
  }
}
