{
  "name": "pocketbun",
  "version": "0.36.2-pocketbun.0",
  "private": true,
  "main": "dist/index.js",
  "types": "index.ts",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "pocketbun": "bin/pocketbun"
  },
  "scripts": {
    "upstream:sync": "bash scripts/sync_upstream_pocketbase.sh",
    "upstream:audit": "bun run scripts/audit_upstream_mapping.ts",
    "test": "bun test --concurrent",
    "start": "bun run index.ts",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src tests",
    "format": "oxfmt --check src tests",
    "format:fix": "oxfmt --write src tests",
    "build": "bun build index.ts examples/base/main.ts --outdir dist --target bun --format esm --packages external",
    "prepack": "bun run build",
    "e2e": "bun run scripts/e2e_run.ts",
    "e2e:install": "playwright install --with-deps"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "index.ts",
    "README.md",
    "LICENSE.md",
    "pocketbase_tag.txt",
    "vendor/pocketbase-admin-ui/dist/",
    "vendor/pocketbase-admin-ui/LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/bun": "latest",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.42.0",
    "oxlint-tsgolint": "^0.11.4",
    "pocketbase": "^0.26.2"
  },
  "peerDependencies": {
    "go-text-template": "*",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "go-text-template": {
      "optional": true
    }
  }
}
