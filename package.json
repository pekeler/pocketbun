{
  "name": "pocketbun",
  "version": "0.36.2-pocketbun.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pekeler/pocketbun.git"
  },
  "bugs": {
    "url": "https://github.com/pekeler/pocketbun/issues"
  },
  "homepage": "https://github.com/pekeler/pocketbun#readme",
  "main": "dist/index.js",
  "types": "index.ts",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "pocketbun": "bin/pocketbun"
  },
  "scripts": {
    "upstream:sync": "bash scripts/sync_upstream_pocketbase.sh",
    "upstream:sync:benchmarks": "bash scripts/sync_upstream_benchmarks.sh",
    "upstream:audit": "bun run scripts/audit_upstream_mapping.ts",
    "test": "bun test --concurrent",
    "start": "bun run index.ts",
    "typecheck": "bun x tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "oxlint --type-aware src tests",
    "format": "oxfmt --check src tests",
    "format:fix": "oxfmt --write src tests",
    "build": "bun build index.ts src/cli.ts --outdir dist --target bun --format esm --packages external",
    "prepack": "bun run build",
    "bench:upstream": "bun run scripts/bench_run_upstream.ts",
    "bench:upstream:pocketbun": "bun run scripts/bench_run_upstream_pocketbun.ts",
    "bench:upstream:factor-summary": "bun scripts/bench_upstream_factor_summary.js",
    "release:check": "bun run format:fix && bun test --concurrent && bun run typecheck && bun run lint",
    "release:dry": "bash scripts/release.sh dry pocketbun",
    "release": "bash scripts/release.sh publish pocketbun",
    "release:create:dry": "bash scripts/release.sh dry create-pocketbun",
    "release:create": "bash scripts/release.sh publish create-pocketbun",
    "e2e": "bun run scripts/e2e_run.ts",
    "e2e:install": "playwright install --with-deps"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "index.ts",
    "README.md",
    "LICENSE.md",
    "pocketbase_tag.txt",
    "vendor/pocketbase-admin-ui/dist/",
    "vendor/pocketbase-admin-ui/LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "latest",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.43.0",
    "oxlint-tsgolint": "^0.11.5",
    "pocketbase": "^0.26.8"
  },
  "peerDependencies": {
    "go-text-template": "*",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "go-text-template": {
      "optional": true
    }
  }
}
